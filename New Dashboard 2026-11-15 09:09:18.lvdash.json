{
  "datasets": [
    {
      "name": "029bebce",
      "displayName": "Highest Value Order",
      "queryLines": [
        "SELECT\r\n",
        "  o.order_id,\r\n",
        "  c.name AS customer,\r\n",
        "  p.product_name,\r\n",
        "  o.quantity,\r\n",
        "  p.unit_price,\r\n",
        "  ROUND(o.quantity * p.unit_price, 2) AS order_value\r\n",
        "FROM workspace.default.orders AS o\r\n",
        "JOIN workspace.default.customers AS c\r\n",
        "  ON o.customer_id = c.customer_id\r\n",
        "JOIN workspace.default.products AS p\r\n",
        "  ON o.product_id = p.product_id\r\n",
        "ORDER BY order_value DESC\r\n",
        "LIMIT 5;"
      ]
    }
  ],
